# Application and Docker image versions
GWATCHO_USER_SERVICE_VERSION=1.0.0
GWATCHO_PRODUCT_SERVICE_VERSION=1.0.0
GWATCHO_ORDER_SERVICE_VERSION=1.0.0
GWATCHO_PAYMENT_SERVICE_VERSION=1.0.0
GWATCHO_DELIVERY_SERVICE_VERSION=1.0.0
GWATCHO_API_GATEWAY_VERSION=1.0.0
GWATCHO_ANGULAR_FRONTEND_VERSION=1.0.0

# GWatcho Infrastructure - local development only
# Copy this file to .env and change credentials before sharing the environment.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER_PASSWORD=user_password
MYSQL_PRODUCT_PASSWORD=product_password
MYSQL_ORDER_PASSWORD=order_password
MYSQL_PAYMENT_PASSWORD=payment_password
MYSQL_DELIVERY_PASSWORD=delivery_password

MYSQL_USER_PORT=3307
MYSQL_PRODUCT_PORT=3308
MYSQL_ORDER_PORT=3309
MYSQL_PAYMENT_PORT=3310
MYSQL_DELIVERY_PORT=3311
KAFKA_PORT=9092
KEYCLOAK_PORT=8080
API_GATEWAY_PORT=8085
FRONTEND_PORT=80

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional E2E-test credentials used by local test scripts
E2E_KEYCLOAK_CLIENT_SECRET=
E2E_KEYCLOAK_PASSWORD=
